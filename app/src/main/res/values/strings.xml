    <!-- Accessibility service -->
    <string name="a11y_service_label">GameBridge Input Bridge</string>
    <string name="a11y_service_summary">Maps keyboard and mouse to touch controls for games</string>
    <string name="a11y_service_description">GameBridge turns your USB/Bluetooth keyboard and mouse into a touch controller so you can play games like Call of Duty Mobile with WASD movement, mouse aim and custom keymaps. It injects touches on your behalf and never reads or modifies game data.</string>

