    <!-- Disclaimer -->
    <string name="disclaimer_title">Before you start</string>
    <string name="disclaimer_body">GameBridge is an input mapper only — like gamepad mappers. It does NOT modify the game, read game memory, or give auto-aim/ESP. However, game publishers may consider third-party input tools a violation of their terms of service, and account bans have been reported for similar apps. Use it at your own risk.</string>
